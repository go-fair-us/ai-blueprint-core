direction: down

# Left side
tools: Tools\n (code or APIs \n you already have) {
  style: {
    fill: "#DBEAFE"
    stroke: "#2563EB"
    stroke-width: 2
    border-radius: 12
    font-size: 16
  }
  width: 150
  height: 100
}
prompts: Prompts\n (example prompts) {
  style: {
    fill: "#DBEAFE"
    stroke: "#2563EB"
    stroke-width: 2
    border-radius: 12
    font-size: 16
  }
  width: 150
  height: 100
}
resources: Resources\n (static resources) {
  style: {
    fill: "#DBEAFE"
    stroke: "#2563EB"
    stroke-width: 2
    border-radius: 12
    font-size: 16
  }
  width: 150
  height: 100
}

# Center
mcp: MCP {
  style: {
    fill: "#F5F3FF"
    stroke: "#7C3AED"
    stroke-width: 4
    border-radius: 16
    font-size: 22
    font-color: "#5B21B6"
    bold: true
  }
  width: 140
  height: 100
}

# Above MCP
elicitations: Elicitations {
