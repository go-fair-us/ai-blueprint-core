# ---- Equation 4 ----
eq4: "APIs with context, MCP, Skills and Semantic Layer for Agent Ready" {
  grid-columns: 7
  grid-gap: 30

  repo: repository {
    width: 140
    style.fill: "#DBEAFE"
    style.stroke: "#2563EB"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 20
  }
  config: "AI aligned\nconfiguration" {
    width: 140
    style.fill: "#DBEAFE"
    style.stroke: "#2563EB"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 20
  }
  apis: APIs {
    width: 140
    style.fill: "#FEF3C7"
    style.stroke: "#D97706"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 20
  }
  mcp: MCP {
    width: 140
    style.fill: "#FEF3C7"
    style.stroke: "#D97706"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 20
  }
  context: Context {
    width: 140
    style.fill: "#FEF3C7"
    style.stroke: "#D97706"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 20
  }
  skills: Skills {
    width: 140
    style.fill: "#FEF3C7"
    style.stroke: "#D97706"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 20
  }
  result: "Agent Ready" {
    width: 140
    style.fill: "#D1FAE5"
    style.stroke: "#059669"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 20
    style.bold: true
  }

  repo -> config: +
  config -> apis: +
  apis -> mcp: +
  mcp -> context: +
  context -> skills: +
  skills -> result: =
}
