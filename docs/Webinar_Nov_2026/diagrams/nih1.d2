grid-rows: 4
grid-gap: 50
vertical-gap: 60

# ---- Equation 1 ----
eq1: "Data repository with web site for users" {
  grid-columns: 3
  grid-gap: 40

  repo: repository {
    width: 180
    style.fill: "#DBEAFE"
    style.stroke: "#2563EB"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 25
  }
  web: website {
    width: 180
    style.fill: "#DBEAFE"
    style.stroke: "#2563EB"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 25
  }
  result: "User\nexperience" {
    width: 180
    style.fill: "#D1FAE5"
    style.stroke: "#059669"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 25
    style.bold: true
  }

  repo -> web: +
  web -> result: =
}

