    "name": "Full Name of Primary Investigator",
    "identifier": {
      "@type": "PropertyValue",
      "propertyID": "orcid",
      "value": "https://orcid.org/0000-0000-0000-0000"
    }
  },
  "citation": "Doe J et al. (2024). Title. NIAID Repository. DOI:10.1234/your.dataset.doi",
  "host": [
    {
      "@type": "BioPopulation",
      "scientificName": "Homo sapiens",
      "identifier": "NCBITaxon:9606",
      "identifierURI": "http://purl.obolibrary.org/obo/NCBITaxon_9606",
      "role": "host"
    }
    // add more host objects if needed
  ],
  "infectiousAgent": [
    {
      "@type": "InfectiousAgent",
      "scientificName": "SARS‑CoV‑2",
      "identifier": "NCBITaxon:2697049",
      "identifierURI": "http://purl.obolibrary.org/obo/NCBITaxon_2697049",
      "role": "infectiousAgent",
      "strainIdentifier": "GenBank:MN908947"
    }
    // add additional pathogen objects as required
  ],
  "apiEndpoint": "GET https://api.niaid.nih.gov/datasets/10.1234/your.dataset.doi (application/ld+json)"
}
