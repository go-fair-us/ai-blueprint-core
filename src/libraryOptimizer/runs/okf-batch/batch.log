  },
  "name": "Descriptive title of the dataset",
  "description": "Short free‑text description of what the dataset contains and its relevance.",
  "datePublished": "YYYY-MM-DD",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "keywords": ["infectious disease", "COVID‑19", "influenza", "TB", "..."],
  "creator": {
