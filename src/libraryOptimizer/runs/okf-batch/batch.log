    { "@type": "PropertyValue", "name": "host", "value": "Homo sapiens", "taxonId": "NCBITaxon:9606" },
    { "@type": "PropertyValue", "name": "healthCondition", "value": "Influenza", "taxonId": "NCBITaxon:115406" }
