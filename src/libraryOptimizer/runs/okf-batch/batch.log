  "spatialCoverage": {
    "@type": "Place",
    "name": "Geographic description"
  },
  "temporalCoverage": "YYYY‑MM‑DD/YYYY‑MM‑DD",
  "distribution": [                         // optional but recommended
    {
      "@type": "DataDownload",
      "encodingFormat": "application/…",
      "contentUrl": "https://…"
    }
  ],
  "host": [                                 // **required** – array of objects
