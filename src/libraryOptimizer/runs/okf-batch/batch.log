      "@type": "BioPopulation",            // as defined in the Blueprint
      "scientificName": "Homo sapiens",
      "identifier": "NCBITaxon:9606",
      "identifierURI": "http://purl.obolibrary.org/obo/NCBITaxon_9606",
      "role": "host",
      "strainIdentifier": "…"              // only if a strain/isolate is specified
    }
    // …additional host objects
  ],
  "infectiousAgent": [                      // **required** – array of objects
    {
      "@type": "InfectiousAgent",
      "scientificName": "Poliovirus",
      "identifier": "NCBITaxon:12081",
      "identifierURI": "http://purl.obolibrary.org/obo/NCBITaxon_12081",
      "role": "infectiousAgent",
      "strainIdentifier": "GenBank:ABC12345"
    }
    // …additional pathogen objects
