  },
  "url": "https://data.niaid.nih.gov/datasets/…",          // optional landing‑page URL
  "name": "…",
  "description": "…",
  "datePublished": "YYYY-MM-DD",
  "dateModified": "YYYY-MM-DD",            // if known
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "keywords": ["…","…"],
  "measurementTechnique": ["…"],           // any that are obvious
  "creator": {
    "@type": "Person",                     // or Organization
    "name": "Full Name",
    "identifier": {
      "@type": "PropertyValue",
      "propertyID": "orcid",
      "value": "https://orcid.org/0000‑0000‑0000‑0000"
    },
    "affiliation": {
      "@type": "Organization",
      "name": "Affiliated Institute"
    }
  },
  "contributor": [                         // optional, repeatable
