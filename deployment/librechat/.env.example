# Copy to .env and fill in NRP_API_KEY and/or OPENROUTER_KEY.
# Generate fresh JWT/CREDS values before any non-localhost use.

HOST=localhost
PORT=3080
DOMAIN_CLIENT=http://127.0.0.1:3080
DOMAIN_SERVER=http://127.0.0.1:3080

# NRP custom endpoint plus Agents (MCP tools attach on the agents path)
ENDPOINTS=custom,agents

NRP_API_KEY=replace-me

# OpenRouter custom endpoint (Blueprint (OpenRouter) / stealth/ox-alpha).
# Use OPENROUTER_KEY, not OPENROUTER_API_KEY — the latter overrides LibreChat's
# built-in OpenAI endpoint.
# docker compose reads this file (and the shell). A shell export alone is not
# enough unless OPENROUTER_KEY is in this file or the process environment.
OPENROUTER_KEY=replace-me

# Required by LibreChat. These are NOT usable values — generate your own, even
# for localhost. CREDS_KEY/CREDS_IV are the AES-256-CTR key and IV that encrypt
# user-supplied API keys and MCP OAuth tokens at rest in Mongo, so the lengths
# are exact: 64 hex chars (32 bytes) and 32 hex chars (16 bytes).
#
#   JWT_SECRET / JWT_REFRESH_SECRET / MEILI_MASTER_KEY   openssl rand -hex 32
#   CREDS_KEY                                            openssl rand -hex 32
#   CREDS_IV                                             openssl rand -hex 16
JWT_SECRET=GENERATE_ME
JWT_REFRESH_SECRET=GENERATE_ME
CREDS_KEY=GENERATE_ME_64_HEX_CHARS
CREDS_IV=GENERATE_ME_32_HEX_CHARS
MEILI_MASTER_KEY=GENERATE_ME

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

DEBUG_LOGGING=false
SEARCH=false
